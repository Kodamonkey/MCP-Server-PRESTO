# Copy to .env and adjust as needed.
# Canonical config: edit ONLY this file (not PRESTO_* in Cursor/Claude JSON).
# Loaded automatically from the repo root when the server starts.

# Docker image (pinned tag; record the digest in the manifest at runtime)
PRESTO_IMAGE=alex88ridolfi/presto5:png

# Filesystem roots (relative paths resolve against repo root)
PRESTO_DATA_DIR=./data
PRESTO_RUNS_DIR=./runs
PRESTO_OUTPUTS_DIR=./outputs
PRESTO_LOGS_DIR=./logs

# Resource caps applied to every Docker invocation
PRESTO_DEFAULT_CPUS=4
PRESTO_DEFAULT_MEMORY_MB=8192
PRESTO_DEFAULT_TIMEOUT_SECONDS=1800
PRESTO_MAX_CONCURRENT_RUNS=2

# Container network mode. Keep "none" — internet access is not needed for PRESTO.
PRESTO_NETWORK=none

# Optional. If true, config.py skips the docker info + data-file size check.
# Useful in unit tests; never set in production.
PRESTO_SKIP_HEALTHCHECK=false
