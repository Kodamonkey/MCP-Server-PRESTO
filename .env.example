# User-facing config (recommended).
# Copy this file to .env and edit as needed.

# PRESTO runtime image.
PRESTO_IMAGE=alex88ridolfi/presto5:png

# Observation files location.
PRESTO_DATA_DIR=./data

# Where run metadata and generated artifacts are written.
# You can point these to absolute paths (for example, next to your data folder).
PRESTO_RUNS_DIR=./runs
PRESTO_OUTPUTS_DIR=./outputs
PRESTO_LOGS_DIR=./logs

# Auto-start Docker Desktop when needed (Windows/macOS).
PRESTO_AUTO_START_DOCKER=true
